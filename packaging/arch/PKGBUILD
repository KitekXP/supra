pkgname=tsux
pkgver=1.0.0
pkgrel=1
pkgdesc="Small alternative to sudo"
arch=('x86_64')
url='https://github.com/KitekXP/tsux'
license=('GPL3')
depends=('pam')
source=()
sha256sums=()

package() {
    install -Dm755 ../../build/tsux \
        "$pkgdir/usr/bin/tsux"

    install -Dm644 ../../build/docs/tsux.1 \
        "$pkgdir/usr/share/man/man1/tsux.1"

    install -Dm644 ../../COPYING \
        "$pkgdir/usr/share/licenses/tsux/COPYING"
}
